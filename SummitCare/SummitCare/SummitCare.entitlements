<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Solution 2: passkeys for summitcare.example -->
  <key>com.apple.developer.associated-domains</key>
  <array>
    <string>webcredentials:summitcare.example</string>
  </array>
  <!-- Solution 24: shared with SummitCareNotificationService; also the Keychain
       access group for the access token (TokenStore.saveAccessToken). -->
  <key>com.apple.security.application-groups</key>
  <array>
    <string>group.com.summitcare.app</string>
  </array>
  <key>keychain-access-groups</key>
  <array>
    <string>$(AppIdentifierPrefix)com.summitcare.app</string>
  </array>
</dict>
</plist>
