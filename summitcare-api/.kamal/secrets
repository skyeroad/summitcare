# Secrets come from AWS Secrets Manager at deploy time (Solution 34). Nothing
# secret is committed; this file only says where to fetch it.
SECRETS=$(kamal secrets fetch --adapter aws_secrets_manager --account default \
  --from summitcare/production/ RAILS_MASTER_KEY)
RAILS_MASTER_KEY=$(kamal secrets extract RAILS_MASTER_KEY $SECRETS)
KAMAL_REGISTRY_PASSWORD=$(aws ecr get-login-password --region us-east-1)
