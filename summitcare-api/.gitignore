# See https://help.github.com/articles/ignoring-files for more about ignoring files.
/.bundle
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

# Production credentials never live in the repository (Solution 34). The
# development and test keys ARE committed on purpose: they protect only
# synthetic data and let the test suite run after a clone.
/config/master.key
/config/credentials/production.key

# Synthea output (Solution 32)
/tmp/synthea
